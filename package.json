{
  "name": "universal-safelink-bypasser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi Web Universal untuk Melewati Safelinku dan 10.000+ Shortlink Tanpa Iklan",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "vercel-build": "npm run build:client",
    "test": "npm --prefix server run test"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0"
  }
}
